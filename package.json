  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@tryforge/forgescript": "^2.6.0",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "mc-server-management": "^3.2.1",
    "node-mcstatus": "^1.2.1",
    "tiny-typed-emitter": "^2.1.0"
  }
}
